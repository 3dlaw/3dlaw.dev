---
import '../styles/global.css';
import Teleport from '../components/Teleport.astro';
interface Props { title: string; description?: string; immersive?: boolean; }
const { title, description = 'The personal corner of Dan Lawrence. Exploring design, code, and imagined worlds.', immersive = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const navigation = [
  { label: 'Home', path: '' },
  { label: 'Projects', path: 'projects/' },
  { label: 'Writing', path: 'writing/' },
  { label: 'About', path: 'about/' },
];
const active = (path: string) => path ? Astro.url.pathname.startsWith(`${base}${path}`) : Astro.url.pathname === base;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#141218" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title === 'Home' ? '3DLaw — A place for curiosity' : `${title} | 3DLaw`}</title>
  </head>
  <body class:list={{ 'immersive-home': immersive }}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="wordmark" href={base} aria-label="3DLaw home">3D<span>LAW</span><i aria-hidden="true"></i></a>
        <nav aria-label="Main navigation">
          {navigation.map(({label, path}) => <a href={`${base}${path}`} aria-current={active(path) ? 'page' : undefined}>{label}</a>)}
        </nav>
        <a class="header-github" href="https://github.com/3dlaw" aria-label="3dlaw on GitHub">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.87c-2.78.61-3.37-1.18-3.37-1.18-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.52 2.34 1.08 2.91.83.09-.64.35-1.08.64-1.33-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.03A9.58 9.58 0 0 1 12 6.83a9.6 9.6 0 0 1 2.5.34c1.91-1.3 2.75-1.03 2.75-1.03.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85v2.75c0 .26.18.58.69.48A10 10 0 0 0 12 2Z"/></svg>
        </a>
      </header>
      <main id="main-content" tabindex="-1"><slot /></main>
      {!immersive && <footer class="site-footer">
        <a class="footer-signature" href={base}>3DLaw<span>Always a work in progress.</span></a>
        <div class="footer-links"><a href="https://github.com/3dlaw">GitHub <span aria-hidden="true">↗</span></a><span>© {new Date().getFullYear()} Dan Lawrence</span></div>
      </footer>}
    </div>
    {!immersive && <Teleport />}
  </body>
</html>
