---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sculpture from '../components/Sculpture.astro';
import ProjectCards from '../components/ProjectCards.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Home">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow"><span class="small-star" aria-hidden="true">✳</span> The personal corner of Dan Lawrence</p>
      <h1 id="hero-title">Following<br />my <em>curiosity.</em></h1>
      <p class="hero-description">Exploring ideas through design, code,<br class="desktop-break" /> and imagined worlds.</p>
      <div class="hero-actions"><a class="button" href="#explorations">Explore the work <span aria-hidden="true">↘</span></a><a class="text-link" href={`${base}about/`}>A little about me <span aria-hidden="true">↗</span></a></div>
    </div>
    <Sculpture />
    <div class="hero-footnote"><span>Somewhere between the technical and the imagined.</span><a href="#explorations" aria-label="Scroll to current explorations">Scroll to explore <span aria-hidden="true">↓</span></a></div>
  </section>
  <section class="explorations section-space" id="explorations" aria-labelledby="explorations-title">
    <div class="section-heading"><div><p class="eyebrow">A few things taking shape</p><h2 id="explorations-title">Current explorations<span class="heading-dot">.</span></h2></div><a class="text-link" href={`${base}projects/`}>All projects <span aria-hidden="true">↗</span></a></div>
    <ProjectCards />
  </section>
  <section class="notebook-band" aria-labelledby="notebook-title"><div><p class="eyebrow">Notes along the way</p><h2 id="notebook-title">Making room for<br /><em>the next question.</em></h2></div><div class="notebook-copy"><p>A place for discoveries, experiments, and things worth understanding a little better.</p><a class="text-link" href={`${base}writing/`}>Visit the notebook <span aria-hidden="true">↗</span></a></div></section>
</BaseLayout>
